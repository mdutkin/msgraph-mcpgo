# Server Configuration
ENVIRONMENT=development
SERVER_PORT=8080

# Azure AD / EntraID Configuration
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here

# Timeouts
GRAPH_TIMEOUT=30s

# Caching
TOKEN_CACHE_TTL=5m
JWKS_CACHE_TTL=24h

# Observability
LOG_LEVEL=info
METRICS_PORT=9090

# Rate Limiting
RATE_LIMIT_PER_USER=100
