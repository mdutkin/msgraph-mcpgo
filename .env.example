# Server Configuration
ENVIRONMENT=development
SERVER_PORT=8080

# Externally reachable base URL. Published as the OAuth 2.0 protected resource
# identifier (RFC 9728) and advertised in the WWW-Authenticate header of every
# 401, so it must match the hostname clients connect to.
PUBLIC_URL=http://localhost:8080

# "internet" (default) requires PUBLIC_URL to be https. Use "internal" for a
# deployment reached only inside the private network, for example an ECS
# service addressed over Service Connect at http://msgraph-mcp:8080.
NETWORK_EXPOSURE=internal

# Keep the Streamable HTTP transport stateless. Required whenever more than one
# task serves the same load balancer target group.
MCP_STATELESS=true

# YAML document selecting which tools and resources are exposed. Copy
# tools.example.yaml to get started. When this variable is set, a missing file
# stops startup; when it is unset and tools.yaml is absent, everything is
# exposed.
TOOL_POLICY_FILE=tools.yaml

# Microsoft Entra ID. Only the tenant is needed: this service forwards the
# caller's Microsoft Graph access token and holds no credential of its own, so
# there is no client ID to be an audience for and no client secret to exchange.
AZURE_TENANT_ID=your-tenant-id-here

# How a caller is authenticated.
#
#   verified_identity  Graph token in Authorization, plus an Entra token in
#                      IDENTITY_ASSERTION_HEADER whose signature is verified
#                      against the tenant's published keys. The verified
#                      identity is what the audit log and the rate limiter use.
#   graph_passthrough  Graph token only. Nothing is signature-verified, because
#                      Microsoft publishes no keys for tokens issued to its own
#                      APIs. The recorded identity is whatever the token claims.
#   disabled           No inspection. Development only.
AUTH_MODE=verified_identity

# Accepted "aud" values of the assertion, comma separated. For LibreChat's
# {{LIBRECHAT_OPENID_ID_TOKEN}} this is the LibreChat application's client ID.
IDENTITY_AUDIENCES=

IDENTITY_ASSERTION_HEADER=X-Identity-Assertion

# Signing keys are re-read on this interval, and additionally on demand when an
# assertion arrives signed by an unseen key, so a rotation takes effect at once.
# On-demand reads are rate limited by the second value.
JWKS_REFRESH_INTERVAL=12h
JWKS_MIN_REFRESH_INTERVAL=5m

# Only for a sovereign cloud, for example
# https://login.microsoftonline.us/<tenant>/v2.0/.well-known/openid-configuration
# ENTRA_DISCOVERY_URL=

# Timeouts
GRAPH_TIMEOUT=30s

# Observability
LOG_LEVEL=info
METRICS_PORT=9090

# Rate Limiting. The allowance is per user, per minute, per task; it is not
# shared between tasks. 0 disables throttling.
RATE_LIMIT_PER_USER=100
RATE_LIMIT_BURST=0
RATE_LIMIT_IDLE_TTL=15m
